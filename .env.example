# Скопируйте этот файл в .env и заполните реальными значениями
# НЕ КОММИТЬТЕ .env файл в Git!

# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz-EXAMPLE
BOT_USERNAME=@FPSKGuide_bot

# Operator Chat ID
# Чтобы получить свой chat_id:
# 1. Отправьте сообщение боту @userinfobot
# 2. Или используйте: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
OPERATOR_CHAT_ID=123456789

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/fpsk_dataBase
DB_USERNAME=postgres
DB_PASSWORD=postgres
